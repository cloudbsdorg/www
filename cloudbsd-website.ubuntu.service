[Unit]
Description=CloudBSD Website Service (Node.js)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/cloudbsd-website
ExecStart=/usr/local/bin/serve -s dist -l tcp://127.0.0.1:3000
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
