#!/bin/sh

# PROVIDE: cloudbsd_website
# REQUIRE: DAEMON
# KEYWORD: shutdown

. /etc/rc.subr

name="cloudbsd_website"
rcvar="cloudbsd_website_enable"

# Configuration
load_rc_config $name
: ${cloudbsd_website_enable:="NO"}
: ${cloudbsd_website_svcuser:="www"}
: ${cloudbsd_website_chdir:="/usr/local/www/cloudbsd-website"}
: ${cloudbsd_website_log:="/var/log/${name}.log"}
: ${cloudbsd_website_pidfile:="/var/run/${name}.pid"}

# The daemon(8) utility provides supervision and automatic restarts (-r)
command="/usr/sbin/daemon"
# -u: drop privileges to this user AFTER creating the supervisor pid
# -r: restart child if it crashes
# -f: direct output to log file
# -P: supervisor pid file (created as root in /var/run)
# -p: child pid file
# -o: log file output
command_args="-u ${cloudbsd_website_svcuser} -r -f -P ${cloudbsd_website_pidfile} -p ${cloudbsd_website_chdir}/child.pid -o ${cloudbsd_website_log} ${cloudbsd_website_chdir}/node_modules/.bin/serve -s ${cloudbsd_website_chdir}/dist -l tcp://127.0.0.1:3000"

# Environment and execution context
# Note: We use _svcuser above instead of _user to prevent rc.subr from 
# dropping privileges automatically before daemon(8) can create the pidfile.
cloudbsd_website_chdir=${cloudbsd_website_chdir}
cloudbsd_website_env="PATH=/usr/local/bin:/usr/bin:/bin HOME=${cloudbsd_website_chdir}"

pidfile="${cloudbsd_website_pidfile}"

start_precmd="cloudbsd_website_prestart"

cloudbsd_website_prestart()
{
	# Ensure log file exists and is writable by the service user
	if [ ! -f "${cloudbsd_website_log}" ]; then
		touch "${cloudbsd_website_log}"
		chown "${cloudbsd_website_svcuser}" "${cloudbsd_website_log}"
	fi

	# Ensure the directory is writable for the child pid file
	chown "${cloudbsd_website_svcuser}" "${cloudbsd_website_chdir}"
}

run_rc_command "$1"



